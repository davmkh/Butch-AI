# Copy this file to server/.env and fill in values. Never commit .env (the repo is public).

# --- Server ---
PORT=3001
# Where the React app runs; used for CORS in production.
CLIENT_ORIGIN=http://localhost:5173
# Max questions per minute from one IP address (curbs abuse and AI cost).
RATE_LIMIT_PER_MINUTE=20

# --- Database ---
# Matches docker-compose.yml (local dev only). Start it with `npm run db:up`.
# Leave blank to keep everything in memory instead (lost when the server restarts).
DATABASE_URL=postgresql://butch:butch@localhost:5432/butch_ai

# --- Butch's brain ---
# auto     = use DeepSeek if DEEPSEEK_API_KEY is set, otherwise offline mode
# deepseek = always use DeepSeek (fails to start without a key)
# offline  = answer straight from the knowledge base with no AI (free; used by tests)
BUTCH_RESPONDER=auto

# Get a key at https://platform.deepseek.com/api_keys (keep it secret, never commit it).
DEEPSEEK_API_KEY=

# Model ID. deepseek-flash is the cheap, fast tier. Thinking mode is turned off in code.
DEEPSEEK_MODEL=deepseek-flash

# 0 to 1. Below this retrieval score Butch gives the fallback message instead of answering (FR-05).
BUTCH_CONFIDENCE_THRESHOLD=0.6

# Dev only: pretend it's this time, e.g. to demo "Is Southside open?" at midnight.
# Example: BUTCH_FAKE_NOW=2026-09-22T00:00:00-07:00
BUTCH_FAKE_NOW=

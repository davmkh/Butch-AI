{
  "name": "@butch/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Gherkin acceptance tests for Butch AI (Playwright + playwright-bdd)",
  "type": "module",
  "scripts": {
    "e2e": "bddgen && playwright test",
    "e2e:ui": "bddgen && playwright test --ui",
    "e2e:list": "bddgen && playwright test --list",
    "install-browsers": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "playwright-bdd": "^9.2.1"
  }
}
